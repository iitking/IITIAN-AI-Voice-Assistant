# Server Settings
IITIAN_HOST=127.0.0.1
IITIAN_PORT=8080

# Assistant Identity
ASSISTANT_NAME=IITIAN
DEFAULT_USER_NAME=Nivesh

# LangSmith Observability & Tracing (https://smith.langchain.com)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=IITIAN-Voice-Assistant
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Optional LLM Providers (local, openai, gemini, ollama)
LLM_PROVIDER=local
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
